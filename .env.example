# Optional override. Relative paths are resolved from the process working directory.
UAP_DB_PATH=data/uap.db

# Required only when analyze-articles has queued work. Never commit real keys.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: explicit provider override. If empty, DeepSeek is selected when its
# key is present; otherwise OpenAI is selected.
AI_PROVIDER=

# Cost-oriented default for daily processing; override per run with --model.
OPENAI_MODEL=gpt-5.6-luna
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_REASONING_EFFORT=low
