.DS_Store
.env
.env.*.local
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Runtime data is reproducible from migrations and is not committed.
data/*.db
data/*.db-shm
data/*.db-wal

# Generated site content will be committed deliberately in a later phase.
site/generated/

# WP2 platform runtime secrets and local state.
platform/.env
platform/.secrets/
platform/.venv/
platform/.mypy_cache/
platform/.ruff_cache/
platform/.pytest_cache/
platform/.coverage
platform/htmlcov/
