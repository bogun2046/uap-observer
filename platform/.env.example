# Copying this file is not required: `make dev` creates platform/.env with
# random local credentials. Keep all secret values blank in this template.
UAP_COMPOSE_PROJECT_NAME=uap-platform-dev
UAP_APP_ENV=development
UAP_LOG_LEVEL=INFO
UAP_POSTGRES_DB=uap_platform
UAP_POSTGRES_USER=uap_platform
UAP_POSTGRES_PASSWORD=
UAP_MIGRATOR_PASSWORD=
UAP_API_PASSWORD=
UAP_WORKER_PASSWORD=
UAP_SCHEDULER_PASSWORD=
UAP_PUBLISHER_PASSWORD=
UAP_MODEL_GOVERNANCE_PASSWORD=
UAP_PUBLIC_READER_PASSWORD=
UAP_AUDIT_READER_PASSWORD=
UAP_BACKUP_PASSWORD=
UAP_V1_LOCAL_ADMIN_TOKEN=
UAP_S3_ACCESS_KEY=
UAP_S3_SECRET_KEY=
UAP_HEALTH_PORT=8080
UAP_S3_API_PORT=8333
UAP_V1_LIBRARY_PORT=8091
REDDIT_OAUTH_ACCESS_TOKEN=
REDDIT_USER_AGENT=
